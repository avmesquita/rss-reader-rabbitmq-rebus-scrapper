rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /rssUsers/{userId}/actions/{actionId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['type', 'channelCount', 'createdAt'])
                    && request.resource.data.type == 'youtube-subscriptions-import'
                    && request.resource.data.channelCount is int
                    && request.resource.data.channelCount >= 0
                    && request.resource.data.channelCount <= 5000;
      allow update, delete: if false;
    }
  }
}
