# Public host ports
FRONTEND_HOST_PORT=6660
API_HOST_PORT=6661
SCRAPPER_HOST_PORT=6662
RABBITMQ_HOST_PORT=6663
RABBITMQ_MANAGEMENT_HOST_PORT=6664
POSTGRES_HOST_PORT=6665
PGADMIN_HOST_PORT=7771
ADMINER_HOST_PORT=7772

# Docker-internal ports
FRONTEND_PORT=80
API_PORT=8080
SCRAPPER_PORT=3000
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
POSTGRES_PORT=5432
PGADMIN_PORT=80
ADMINER_PORT=8080

# Docker service names
POSTGRES_HOST=rss_postgres
RABBITMQ_HOST=rss_rabbitmq
SCRAPPER_HOST=rss_scrapper

# Development credentials
POSTGRES_DB=rssreader
POSTGRES_USER=rssreader
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=rssreader
RABBITMQ_PASSWORD=change-me
RABBITMQ_WORKER_QUEUE=rss-reader-worker
DEBUG_ENABLED=false

# Fine-tuning
INGESTION_WORKERS=2
INGESTION_INTERVAL_HOURS=1
SCRAPPER_MAX_PARALLELISM=2
ARTICLE_WORKERS=2
STORE_IMAGES_AS_BASE64=false
IMAGE_MAX_BYTES=2000000

# PgAdmin credentials
PGADMIN_DEFAULT_EMAIL=admin@rssreader.com
PGADMIN_DEFAULT_PASSWORD=rssreader